# --- secretos: nunca versionados (05 §5) ---
.env
.env.*
!.env.example
*.pem
*.key
!*.pub

# --- Python ---
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Node ---
node_modules/
.next/
.pnpm-store/
*.tsbuildinfo
next-env.d.ts        # lo regenera `next typegen` en cada build

# --- backups locales: no van al repo ---
*.dump
*.archive
*.age

# --- lo que escribe el actualizador en cada máquina: qué commit quedó ---
# No se versiona: en el repo no hay "versión instalada", y un VERSION viejo
# commiteado haría que todas las máquinas reporten lo mismo, que es justo el
# problema que existe para resolver.
agente/VERSION

# --- sistema ---
.DS_Store

# --- IDE: configuracion local, no del proyecto ---
.idea/
.vscode/

# El SOP en PDF se genera, no se versiona: un PDF viejo en el repositorio es
# exactamente el problema que este proyecto ya tiene con el SOP anterior.
# Se regenera con docs/generar-pdf.py
docs/*.pdf
# Lo mismo para el Word de los comandos, que sale del mismo .md.
docs/*.docx
# Y la página web de los comandos, que sale del mismo .md y se publica aparte.
docs/*.html
