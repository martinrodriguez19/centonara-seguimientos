# Copiá este archivo a .env — los valores por defecto sirven para local.
# El .env nunca se versiona.

# --- backend ---
# El usuario `app` lo crea infra/mongo/01-usuario-app.js al levantar el contenedor.
# Su rol NO otorga update sobre `auditoria`: ahí vive la inmutabilidad del registro.
MONGO_URL=mongodb://app:app-local@localhost:27017/seguimiento?authSource=seguimiento
MONGO_DB=seguimiento
ENTORNO=local                  # local | produccion   (ya no hay staging, D17)
PANEL_PASSWORD=cambiar         # la contraseña del panel (D22)
# Firma la cookie de sesión. Generalo con `openssl rand -hex 32`.
# El comentario va ARRIBA: al lado de un valor vacío, dotenv lo toma COMO el
# valor, y entonces el secreto deja de estar vacío y de fallar cerrado.
SESION_SECRET=
SENTRY_DSN=

# --- panel ---
# URL del backend, usada SÓLO desde el servidor de Next (no lleva NEXT_PUBLIC_:
# el navegador no habla con el backend directo). En Render la inyecta el deploy.
BACKEND_URL=http://localhost:8000

# --- agente ---
AGENTE_BACKEND_URL=http://localhost:8000
AGENTE_TOKEN=
AGENTE_MACHINE_ID=mac-1        # lo elige el admin al dar de alta la máquina
# Fijo por máquina, ver docs/04-AGENTE.md. El comentario va ARRIBA, no al lado:
# cuando el valor queda vacío, dotenv toma el `# ...` como el valor y el
# diagnóstico da un OK falso.
AGENTE_DEVICE_ID=
# Ruta COMPLETA al ejecutable, ver docs/04-AGENTE.md. Mismo motivo que arriba.
CLAUDE_BIN=
# simulado: no toca ningún navegador — TODO envío o borrador "falla" con
#           CHAT_NO_ABRE. Si eso pasa en todos los mensajes de esta máquina,
#           quedó en este modo (fue la causa del 26/08).
# prueba:   escribe el mensaje y lo deja como borrador de WhatsApp, sin enviar.
# real:     puede apretar enviar.
# La máquina pone el techo: en `prueba` no envía aunque el panel pida `real`.
AGENTE_MODO=simulado           # simulado | prueba | real

# --- Chrome, para el motor de envío ---
#
# El agente abre Chrome solo, con el puerto de depuración, antes de escribir un
# mensaje. Vacío = busca las rutas habituales del sistema.
CHROME_BIN=
CHROME_PERFIL=
# ⚠️ El perfil DENTRO de `User Data`, y tiene que ser el que tiene la extensión
# de Claude Y la sesión de WhatsApp. Con varios perfiles, `Default` casi nunca
# es el correcto. Ver docs/SOP-instalar-mac.md §2.5.
CHROME_PERFIL_DIR=Default
CHROME_PUERTO=9222

# A QUIÉN PUEDE ESCRIBIRLE EL SISTEMA
#
# No es una variable de entorno: vive en la colección `configuracion`, campo
# `destinos_permitidos`, y se edita desde el panel (regla R4).
#
# Mientras tenga sólo los números de prueba, es técnicamente imposible que un
# cliente real reciba un mensaje, corra donde corra el sistema. Ponerla en ["*"]
# es lo que lo habilita para todos, y queda registrado en auditoría.
