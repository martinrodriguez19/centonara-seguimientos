# Copiá este archivo a .env — los valores por defecto sirven para local.
# El .env nunca se versiona (05 §5).

# --- backend ---
MONGO_URL=mongodb://localhost:27017
MONGO_DB=seguimiento
JWT_SECRET=                    # openssl rand -hex 32
AUTH_EMAIL_FROM=no-reply@centonara-ia.com
SMTP_URL=smtp://localhost:1025 # Mailpit: los magic links se leen en http://localhost:8025
SENTRY_DSN=
ENTORNO=local                  # local | staging | produccion

# --- agente ---
AGENTE_BACKEND_URL=http://localhost:8000
AGENTE_TOKEN=
AGENTE_MACHINE_ID=PC-1
AGENTE_DEVICE_ID=              # fijo por máquina, ver docs/07-EL-AGENTE.md
CLAUDE_BIN=                    # ruta COMPLETA, ver docs/07-EL-AGENTE.md
AGENTE_MODO=simulado           # simulado | prueba | real

# ENTORNO=produccion es la ÚNICA variable que habilita el envío real.
# En local y staging el backend rechaza encolar envíos reales aunque se lo pidan.
