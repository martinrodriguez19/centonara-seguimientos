{
  "name": "MVP - Templates WhatsApp (2 PCs)",
  "nodes": [
    {
      "parameters": {},
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Disparo manual",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-220, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "v1",
              "name": "run_id",
              "value": "={{ $now.toFormat('yyyyLLdd-HHmmss') }}",
              "type": "string"
            },
            {
              "id": "v2",
              "name": "n_chats",
              "value": 5,
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Parametros",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [0, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://192.168.0.101:8787/run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Agent-Token", "value": "cambiar-esto" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ run_id: $json.run_id, n_chats: $json.n_chats }) }}",
        "options": {
          "timeout": 660000,
          "response": { "response": { "neverError": true } }
        }
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "PC-1",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 180]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://192.168.0.102:8787/run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Agent-Token", "value": "cambiar-esto" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ run_id: $json.run_id, n_chats: $json.n_chats }) }}",
        "options": {
          "timeout": 660000,
          "response": { "response": { "neverError": true } }
        }
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "PC-2",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 420]
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineAll",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Juntar resultados",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [500, 300]
    },
    {
      "parameters": {
        "jsCode": "// Aplana: una fila por chat, con la maquina de origen.\nconst filas = [];\nfor (const item of $input.all()) {\n  const r = item.json;\n  const maquina = r.machine || 'desconocida';\n  if (!r.ok) {\n    filas.push({ maquina, estado: 'error', detalle: r.error || 'sin detalle', raw: r.raw || r.stderr || '' });\n    continue;\n  }\n  const data = r.data || {};\n  for (const c of (data.chats || [])) {\n    filas.push({\n      maquina,\n      run_id: data.run_id || r.run_id,\n      estado: 'ok',\n      contacto: c.contacto,\n      antiguedad: c.antiguedad,\n      ultimo_lo_mando: c.ultimo_lo_mando,\n      resumen: c.ultimo_mensaje_resumen,\n      template: c.template_seguimiento,\n    });\n  }\n}\nreturn filas.map(json => ({ json }));"
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Normalizar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 300]
    }
  ],
  "connections": {
    "Disparo manual": {
      "main": [[{ "node": "Parametros", "type": "main", "index": 0 }]]
    },
    "Parametros": {
      "main": [[
        { "node": "PC-1", "type": "main", "index": 0 },
        { "node": "PC-2", "type": "main", "index": 0 }
      ]]
    },
    "PC-1": {
      "main": [[{ "node": "Juntar resultados", "type": "main", "index": 0 }]]
    },
    "PC-2": {
      "main": [[{ "node": "Juntar resultados", "type": "main", "index": 1 }]]
    },
    "Juntar resultados": {
      "main": [[{ "node": "Normalizar", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
